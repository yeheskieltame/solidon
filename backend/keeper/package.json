    "test": "node --test \"test/*.test.js\""
  },
  "license": "MIT",
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "near-api-js": "^7.4.0",
    "viem": "^2.57.17"
  }
}
