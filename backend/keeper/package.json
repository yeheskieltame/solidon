{
  "name": "solidon-keeper",
  "version": "0.1.0",
  "private": true,
  "description": "Solidon testnet keeper: mock oracle prices, treasury housekeeping (EVM and Solana), signed-tx broadcaster, testnet bridge",
  "type": "module",
  "main": "keeper.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node keeper.js",
