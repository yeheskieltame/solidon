# Copy to backend/.env (gitignored) and fill in. Never commit real keys.

# Pyth Hermes (https://app.pyth.com): sent as "Authorization: Bearer <key>"
PYTH_API_KEY=

# Alchemy (https://dashboard.alchemy.com): one key works for every chain enabled in the app.
# The keeper uses base-sepolia, robinhood-testnet, robinhood-mainnet (Chainlink reads) and solana-devnet.
ALCHEMY_API_KEY=

# --- keeper (backend/keeper) ---------------------------------------------------------------
# Everything below is optional; defaults in brackets. The keeper also reads contracts/.env for
# EVM_DEPLOYER_ADDRESS / EVM_DEPLOYER_PRIVATE_KEY (its testnet EVM wallet).
# FACTORY=                 # [solidon.testnet]
# KEEPER_ACCOUNT=          # [keeper.<FACTORY>], the factory's bridge and relayer
# KEEPER_NEAR_PRIVATE_KEY= # ed25519:...; else ~/.near-credentials/testnet/<KEEPER_ACCOUNT>.json
# KEEPER_EVM_PRIVATE_KEY=  # overrides EVM_DEPLOYER_PRIVATE_KEY from contracts/.env
# NEAR_RPC=                # [https://test.rpc.fastnear.com] views; https://near-testnet.drpc.org spreads the load
# NEAR_RPC_SEND=           # [NEAR_RPC] transactions; keep FastNear here (dRPC fails broadcast_tx_commit)
# BASE_SEPOLIA_RPC=        # [Alchemy base-sepolia]
# HOOD_TESTNET_RPC=        # [Alchemy robinhood-testnet]
# HOOD_MAINNET_RPC=        # [Alchemy robinhood-mainnet], Chainlink reference prices
# SOLANA_DEVNET_RPC=       # [Alchemy solana-devnet, else https://api.devnet.solana.com]
# KEEPER_SOLANA_KEYPAIR=   # [backend/keeper/.secrets/solana-keeper.json], created on first run
# KEEPER_SOL_MIN=          # [0.1], below this the keeper asks for a 1 SOL devnet airdrop
# TREASURY_SOL_MIN=        # [0.01], top up a Solana treasury below this
# TREASURY_SOL_TOPUP=      # [0.02], ...back to this
# SOLANA_CONFIRM_SECS=     # [60], wait for a Solana transaction to confirm
# SOLANA_MAX_RESIGNS=      # [5], resign_solana attempts for one failing buy
# NEARBLOCKS_API_KEY=      # optional, raises the NearBlocks rate limit
# LOOP_SECS=               # [60]
# ORACLE_INTERVAL_SECS=    # [300], must stay under the contracts' 900 s staleness limit
# ORACLE_MAX_FEED_AGE_SECS=  # [90000], older Chainlink answers are not pushed
# KEEPER_SKIP_MEMES=       # memes the keeper leaves alone, comma separated (floor demo)
# FUND_MIN_USDC=           # [1], smallest fund_chain / treasury cash the keeper acts on
# TREASURY_GAS_MIN_ETH=    # [0.0002], top up a treasury below this
# TREASURY_GAS_TOPUP_ETH=  # [0.0005], 0 disables top-ups
# RECEIPT_TIMEOUT_SECS=    # [120]
# CREDIT_MAX_ATTEMPTS=     # [6]
# KEEPER_STATE=            # [backend/keeper/state.json]
# SOLIDON_ENV= / SOLIDON_CONTRACTS_ENV=  # paths of the two env files, e.g. from a git worktree

# --- indexer + read API (backend/keeper: keeper.js, or node indexer.js alone) -------------------
# No key needed. FACTORY and NEAR_RPC above apply too.
# INDEXER_PORT=            # [8788], HTTP API (CORS *, GET only)
# INDEXER_DATA=            # [backend/keeper/data], history/, events/, cursor.json (gitignored)
# INDEXER_POLL_SECS=       # [20], event poll interval
# SNAPSHOT_SECS=           # [LOOP_SECS], one history point per meme per interval
# FASTNEAR_TX_API=         # [https://tx.test.fastnear.com], tx.main.fastnear.com on mainnet
