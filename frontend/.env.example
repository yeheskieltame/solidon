# Copy to .env.local. NEXT_PUBLIC_* values are public and have these defaults; the faucet values at the end are server-only secrets.
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_FACTORY=solidon.testnet
NEXT_PUBLIC_USDC=usdc.solidon.testnet

# Optional overrides. NEAR RPCs are tried in order (comma-separated).
# NEXT_PUBLIC_NEAR_RPC=https://test.rpc.fastnear.com,https://rpc.testnet.near.org
# NEXT_PUBLIC_NEARBLOCKS_API=https://api-testnet.nearblocks.io
# NEXT_PUBLIC_BASE_RPC=https://sepolia.base.org
# NEXT_PUBLIC_ROBINHOOD_RPC=https://rpc.testnet.chain.robinhood.com
# NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Where the two sites live (one build serves both; see src/proxy.ts).
# Default: the app at /app on the same host. Production: an absolute URL on the app subdomain.
# NEXT_PUBLIC_APP_URL=https://app.solidon.example
# NEXT_PUBLIC_SITE_URL=https://solidon.example

# Testnet faucet (server-only: no NEXT_PUBLIC_ prefix, never sent to the browser, never commit
# real values). The account pays 0.5 NEAR + storage + the USDC mint for each new user.
# FAUCET_ACCOUNT_ID=your-faucet.testnet
# FAUCET_PRIVATE_KEY=ed25519:<full-access secret key of that account>
# FAUCET_DAILY_NEAR=5
# FAUCET_IP_PER_HOUR=6
